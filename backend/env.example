PORT=3001
NODE_ENV=development

# ===========================================================================
# Configuração da IA (OBRIGATÓRIA para a análise de causas e recomendações)
# ---------------------------------------------------------------------------
# Sem uma chave válida aqui, a reconciliação determinística (upload, mapeamento,
# comparação e detecção de divergências) continua funcionando normalmente, mas
# os endpoints de análise por IA (/analyze e /analyze-batch) retornarão erro
# 503 (AI_NOT_CONFIGURED) e nenhuma hipótese ou recomendação será exibida.
#
# AI_PROVIDER define qual provedor usar: "gemini" ou "openai".
# Preencha apenas a chave correspondente ao provedor escolhido.
# ===========================================================================
# AI_PROVIDER=gemini
GEMINI_API_KEY=